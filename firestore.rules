rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }
    match /seats/{s} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /logs/{l} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && l.matches(request.auth.uid + '_.*');
    }
    match /notes/{n} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /rooms/{r} {
      allow read, write: if request.auth != null;
    }
    match /roomMembers/{m} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /roomReqs/{q} {
      allow read, write: if request.auth != null;
    }
    match /roomMsgs/{g} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /data/users/{u}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }
  }
}
